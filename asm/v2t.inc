; v2t: proportional text on a C64 hires bitmap: .v2t text files (docs/v2t-format.md) and
; single lines. ca65 source: .include it in the host program, with font.inc (generated by
; vic2/build.py, format in docs/v2t-format.md) on the include path. API in
; docs/v2t-lib.md; in short (A/Y = address: A low, Y high):
;
;   v2t_draw       A/Y = .v2t: draw it at the position in its header. C=1: not a .v2t
;   v2t_draw_at    A/Y = .v2t: draw it at pixel v2t_x, v2t_y, leading v2t_lead
;   v2t_line       A/Y = 0-terminated screen codes: clear the 8 pixel lines at v2t_x,
;                  v2t_y over v2t_cols cells, colour them v2t_color, draw the text clipped
;                  to them; then v2t_y += 8 + v2t_lead. C=1: clipped
;   v2t_measure    A/Y = 0-terminated screen codes: width in pixels in A (low), X (high)
;   v2t_clear      A = colour: clear v2t_cols x v2t_rows cells from v2t_col, v2t_row
;
; The bitmap (V2T_BITMAP, 8000 bytes) and screen (V2T_SCREEN, the cell colours) default to
; $e000 and $c000, where v2i.inc puts them; define them before the include to draw
; elsewhere. Glyphs are OR'd in, so the bitmap must read back as RAM (bank out a ROM above
; it). The program sets up the VIC (hires bitmap mode, bank, $d018). Colours are cell
; colours, fg << 4 | bg. Zero page: V2T_ZP_SIZE bytes from V2T_ZP (default $1d).

.ifndef V2T_ZP
V2T_ZP = $1d
.endif
.ifndef V2T_BITMAP
V2T_BITMAP = $e000
.endif
.ifndef V2T_SCREEN
V2T_SCREEN = $c000
.endif

; zero page
v2t_ptr = V2T_ZP + 0                    ; 2 bytes each
v2t_src = V2T_ZP + 2
v2t_dst = V2T_ZP + 4
v2t_scr = V2T_ZP + 6
v2t_pp  = V2T_ZP + 8
v2t_pp2 = V2T_ZP + 10                   ; pp + 312, for glyph rows in the next char row
V2T_ZP_SIZE = 12

; draw the .v2t at A/Y at the column, row and leading of its header
v2t_draw:
        sta v2t_ptr
        sty v2t_ptr+1
        ldy #4                          ; x = column * 8
        lda (v2t_ptr),y
        ldx #0
        stx v2t_tx+1
        asl
        asl
        asl
        rol v2t_tx+1
        sta v2t_tx
        iny                             ; y = row * 8
        lda (v2t_ptr),y
        asl
        asl
        asl
        sta v2t_ty
        ldy #9
        lda (v2t_ptr),y
        sta v2t_tlead
        jmp v2t_draw_go

; draw the .v2t at A/Y at pixel v2t_x, v2t_y with leading v2t_lead
v2t_draw_at:
        sta v2t_ptr
        sty v2t_ptr+1
        lda v2t_x
        sta v2t_tx
        lda v2t_x+1
        sta v2t_tx+1
        lda v2t_y
        sta v2t_ty
        lda v2t_lead
        sta v2t_tlead
v2t_draw_go:
        ldy #3                          ; "V2T" + version
:       lda (v2t_ptr),y
        cmp v2t_magic,y
        bne @bad
        dey
        bpl :-
        ldy #6
        lda (v2t_ptr),y
        sta v2t_twid
        iny
        lda (v2t_ptr),y
        sta v2t_tleft
        beq @done
        jsr v2t_tpos
        clc                             ; first line
        lda v2t_ptr
        adc #10
        sta v2t_ptr
        bcc @line
        inc v2t_ptr+1
@line:  ldy #0                          ; colour, glyph count
        lda (v2t_ptr),y
        sta v2t_tclr
        iny
        lda (v2t_ptr),y
        sta v2t_tn
        jsr v2t_tnext
        jsr v2t_tnext
        lda v2t_tn
        beq @eol                        ; empty line: nothing to colour or draw
        lda v2t_trow
        cmp #25
        bcs :+
        jsr v2t_tcolrows
:       jsr v2t_tglyphs
@eol:   jsr v2t_tdown
        dec v2t_tleft
        bne @line
@done:  clc
        rts
@bad:   sec
        rts

; one line of text at A/Y (screen codes, 0 ends), see the top of the file
v2t_line:
        sta v2t_ptr
        sty v2t_ptr+1
        ldy #0
:       lda (v2t_ptr),y
        beq :+
        iny
        bne :-
:       sty v2t_tn
        lda v2t_x
        sta v2t_tx
        lda v2t_x+1
        sta v2t_tx+1
        lda v2t_y
        sta v2t_ty
        lda v2t_lead
        sta v2t_tlead
        lda v2t_cols
        sta v2t_twid
        lda v2t_color
        sta v2t_tclr
        jsr v2t_tpos
        lda v2t_trow
        cmp #25
        bcs :+
        jsr v2t_tclrrows
        jsr v2t_tcolrows
:       jsr v2t_tglyphs
        php
        lda v2t_y                       ; next line
        clc
        adc #8
        bcs @max
        adc v2t_lead
        bcc :+
@max:   lda #$ff
:       sta v2t_y
        plp
        rts

; width of the text at A/Y in pixels -> A (low), X (high)
v2t_measure:
        sta v2t_ptr
        sty v2t_ptr+1
        lda #0
        sta v2t_tend
        sta v2t_tend+1
        tay
@ch:    lda (v2t_ptr),y
        beq @done
        and #$7f
        tax
        lda v2t_font_w,x
        clc
        adc v2t_tend
        sta v2t_tend
        bcc :+
        inc v2t_tend+1
:       iny
        bne @ch
@done:  lda v2t_tend
        ldx v2t_tend+1
        rts

; clear v2t_cols x v2t_rows cells from column v2t_col, row v2t_row: bitmap 0, colour A
v2t_clear:
        sta v2t_tclr
        lda v2t_col
        sta v2t_tcol
        lda v2t_cols
        sta v2t_twid
        jsr v2t_tclamp
        lda #0
        sta v2t_cs
        lda #8
        sta v2t_ce
        lda v2t_row
        sta v2t_trow
        lda v2t_rows
        sta v2t_tleft
        beq @done
@row:   lda v2t_trow
        cmp #25
        bcs @done
        tax
        jsr v2t_tzero
        ldx v2t_trow
        jsr v2t_tcolour
        inc v2t_trow
        dec v2t_tleft
        bne @row
@done:  rts

; tx, ty -> tcol, trow, tyo; twid clamped to the screen; xlim = right edge + 1 (the last
; glyph's spacing column may hang over it)
v2t_tpos:
        lda v2t_tx+1
        lsr
        lda v2t_tx
        ror
        lsr
        lsr
        sta v2t_tcol
        jsr v2t_tclamp
        lda v2t_ty
        and #7
        sta v2t_tyo
        lda v2t_ty
        lsr
        lsr
        lsr
        sta v2t_trow
        lda v2t_tcol
        clc
        adc v2t_twid
        ldx #0
        stx v2t_xlim+1
        asl
        asl
        asl
        rol v2t_xlim+1
        adc #1                          ; carry is clear (the rol shifted in a 0)
        sta v2t_xlim
        bcc :+
        inc v2t_xlim+1
:       rts

v2t_tclamp:                             ; twid = min(twid, 40 - tcol), 0 if tcol >= 40
        lda #40
        sec
        sbc v2t_tcol
        bcs :+
        lda #0
:       cmp v2t_twid
        bcs :+
        sta v2t_twid
:       rts

v2t_tdown:                              ; next line 8 + tlead pixel lines down
        lda v2t_tyo
        clc
        adc #8
        adc v2t_tlead
@down:  cmp #8
        bcc :+
        sbc #8
        inc v2t_trow
        jmp @down
:       sta v2t_tyo
        rts

v2t_tclrrows:                           ; clear the 8 pixel lines from trow + tyo (trow < 25)
        lda v2t_tyo
        sta v2t_cs
        lda #8
        sta v2t_ce
        ldx v2t_trow
        jsr v2t_tzero
        lda v2t_tyo
        beq :+
        sta v2t_ce
        lda #0
        sta v2t_cs
        ldx v2t_trow
        inx
        cpx #25
        bcs :+
        jsr v2t_tzero
:       rts

v2t_tcolrows:                           ; colour the row(s) the line touches (trow < 25)
        ldx v2t_trow
        jsr v2t_tcolour
        lda v2t_tyo
        beq :+
        ldx v2t_trow
        inx
        cpx #25
        bcs :+
        jsr v2t_tcolour
:       rts

; dst = V2T_BITMAP + X * 320, scr = V2T_SCREEN + X * 40 (bitmap and screen of char row X)
v2t_rowaddr:
        lda #<V2T_BITMAP
        sta v2t_dst
        lda #>V2T_BITMAP
        sta v2t_dst+1
        lda #<V2T_SCREEN
        sta v2t_scr
        lda #>V2T_SCREEN
        sta v2t_scr+1
        cpx #0
        beq @done
@mul:   clc
        lda v2t_dst
        adc #<320
        sta v2t_dst
        lda v2t_dst+1
        adc #>320
        sta v2t_dst+1
        clc
        lda v2t_scr
        adc #40
        sta v2t_scr
        bcc :+
        inc v2t_scr+1
:       dex
        bne @mul
@done:  rts

v2t_tcell:                              ; dst/scr = cell tcol of char row X
        jsr v2t_rowaddr
        lda v2t_tcol
        clc
        adc v2t_scr
        sta v2t_scr
        bcc :+
        inc v2t_scr+1
:       lda v2t_tcol
        asl
        asl
        asl
        bcc :+
        inc v2t_dst+1
:       clc
        adc v2t_dst
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       rts

v2t_tzero:                              ; bitmap bytes cs..ce-1 of twid cells of row X = 0
        jsr v2t_tcell
        ldx v2t_twid
        beq @done
@cell:  lda #0
        ldy v2t_cs
@b:     sta (v2t_dst),y
        iny
        cpy v2t_ce
        bne @b
        lda v2t_dst
        clc
        adc #8
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       dex
        bne @cell
@done:  rts

v2t_tcolour:                            ; twid cells of row X = colour tclr
        jsr v2t_tcell
        lda v2t_tclr
        ldy v2t_twid
        beq @done
@c:     dey
        sta (v2t_scr),y
        bne @c
@done:  rts

; draw tn glyphs from (ptr) at pixel x = tx, row trow + tyo, OR'd into the bitmap; ptr
; ends after them. A glyph that does not end left of xlim and all after it are skipped
; (C=1). Glyph rows below the screen are not drawn.
v2t_tglyphs:
        lda #0
        sta v2t_tclip
        lda v2t_tx
        sta v2t_xlo
        lda v2t_tx+1
        sta v2t_xhi
        lda v2t_trow
        cmp #25
        bcc :+
        lda #$80                        ; off screen: skip all
        sta v2t_tclip
        bne @go
:       ldx #0                          ; in the last row: no glyph rows in the next
        cmp #24
        bcc :+
        ldx #$80
:       stx v2t_tnolow
        tax                             ; dst = bitmap row trow + tyo
        jsr v2t_rowaddr
        lda v2t_tyo
        clc
        adc v2t_dst
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       lda #8                          ; tlim = 8 - tyo
        sec
        sbc v2t_tyo
        sta v2t_tlim
@go:    lda v2t_tn
        bne @chr
        jmp @end
@chr:   ldy #0
        lda (v2t_ptr),y                 ; screen code
        jsr v2t_tnext
        bit v2t_tclip
        bpl :+
        jmp @skip
:       and #$7f
        tax
        lda v2t_font_w,x
        sta v2t_tw
        clc                             ; clip: draw only if x + advance <= xlim
        adc v2t_xlo
        sta v2t_tend
        lda v2t_xhi
        adc #0
        sta v2t_tend+1
        lda v2t_xlim
        cmp v2t_tend
        lda v2t_xlim+1
        sbc v2t_tend+1
        bcs :+
        lda #$80
        sta v2t_tclip
        jmp @skip
:       txa                             ; src = v2t_font_g + code * 8
        sta v2t_src
        lda #0
        asl v2t_src
        rol
        asl v2t_src
        rol
        asl v2t_src
        rol
        sta v2t_src+1
        clc
        lda v2t_src
        adc #<v2t_font_g
        sta v2t_src
        lda v2t_src+1
        adc #>v2t_font_g
        sta v2t_src+1
        lda v2t_xlo                     ; p = dst + (x & ~7), shift = x & 7
        and #7
        sta v2t_tsh
        lda v2t_xlo
        and #$f8
        clc
        adc v2t_dst
        sta v2t_pp
        lda v2t_xhi
        adc v2t_dst+1
        sta v2t_pp+1
        clc                             ; pp2 = pp + 320 - 8: rows tlim..7 go one char row down
        lda v2t_pp
        adc #<312
        sta v2t_pp2
        lda v2t_pp+1
        adc #>312
        sta v2t_pp2+1
        lda #7
        sta v2t_tr
@gl:    ldy v2t_tr
        lda (v2t_src),y
        beq @gnext                      ; empty glyph row
        ldx #0
        stx v2t_tlo
        ldx v2t_tsh
        beq @nosh
@sh:    lsr
        ror v2t_tlo
        dex
        bne @sh
@nosh:  cpy v2t_tlim
        bcs @low
        ora (v2t_pp),y
        sta (v2t_pp),y
        tya
        clc
        adc #8
        tay
        lda v2t_tlo
        ora (v2t_pp),y
        sta (v2t_pp),y
        jmp @gnext
@low:   bit v2t_tnolow                  ; (keeps the carry)
        bmi @gnext
        ora (v2t_pp2),y
        sta (v2t_pp2),y
        tya
        adc #7                          ; carry is set: + 8
        tay
        lda v2t_tlo
        ora (v2t_pp2),y
        sta (v2t_pp2),y
@gnext: dec v2t_tr
        bpl @gl
        clc                             ; x += advance
        lda v2t_xlo
        adc v2t_tw
        sta v2t_xlo
        bcc @skip
        inc v2t_xhi
@skip:  dec v2t_tn
        beq @end
        jmp @chr
@end:   lda v2t_tclip
        asl
        rts

v2t_tnext:
        inc v2t_ptr
        bne :+
        inc v2t_ptr+1
:       rts

; ---- data and state

v2t_magic: .byte "V2T", 3

; parameters
v2t_x:     .word 0                      ; text pixel position
v2t_y:     .byte 0
v2t_lead:  .byte 2                      ; pixel lines between text lines
v2t_color: .byte $f0                    ; light grey on black
v2t_col:   .byte 0                      ; v2t_clear: cells
v2t_row:   .byte 0
v2t_cols:  .byte 40                     ; v2t_line, v2t_clear: width in cells
v2t_rows:  .byte 1

; internal
v2t_tx:    .word 0
v2t_ty:    .byte 0
v2t_tlead: .byte 0
v2t_tcol:  .byte 0
v2t_trow:  .byte 0
v2t_tyo:   .byte 0                      ; pixel line of the text line within char row trow
v2t_twid:  .byte 0
v2t_tleft: .byte 0
v2t_tn:    .byte 0
v2t_tw:    .byte 0
v2t_tclr:  .byte 0
v2t_tclip: .byte 0
v2t_tnolow: .byte 0
v2t_tlo:   .byte 0
v2t_tsh:   .byte 0
v2t_tr:    .byte 0
v2t_tlim:  .byte 0                      ; glyph rows below tlim stay in row trow
v2t_xlo:   .byte 0
v2t_xhi:   .byte 0
v2t_xlim:  .word 0
v2t_tend:  .word 0
v2t_cs:    .byte 0
v2t_ce:    .byte 0

        .include "font.inc"
