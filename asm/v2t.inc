; v2t: proportional text on a C64 hires bitmap: .v2t text files (docs/v2t-format.md) and
; single lines. ca65 source: .include it in the host program, with font.inc (generated by
; vic2/build.py: a GEOS font record, format in docs/v2t-format.md) on the include path.
; API in docs/v2t-lib.md; in short (A/Y = address: A low, Y high; text is character codes
; 32-127, ASCII; H = the font's height, V2T_FONT_H):
;
;   v2t_draw       A/Y = .v2t: draw it at the position in its header. C=1: not a .v2t
;                  (or made for a font of another height)
;   v2t_draw_at    A/Y = .v2t: draw it at pixel v2t_x, v2t_y, leading v2t_lead
;   v2t_line       A/Y = 0-terminated text: clear the H pixel lines at v2t_x, v2t_y over
;                  v2t_cols cells, colour them v2t_color, draw the text clipped to them;
;                  then v2t_y += H + v2t_lead. C=1: clipped
;   v2t_measure    A/Y = 0-terminated text: width in pixels in A (low), X (high)
;   v2t_clear      A = colour: clear v2t_cols x v2t_rows cells from v2t_col, v2t_row
;
; The bitmap (V2T_BITMAP, 8000 bytes) and screen (V2T_SCREEN, the cell colours) default to
; $e000 and $c000, where v2i.inc puts them; define them before the include to draw
; elsewhere. Glyphs are OR'd in, so the bitmap must read back as RAM (bank out a ROM above
; it). The program sets up the VIC (hires bitmap mode, bank, $d018). Colours are cell
; colours, fg << 4 | bg. Zero page: V2T_ZP_SIZE bytes from V2T_ZP (default $1d).

.ifndef V2T_ZP
V2T_ZP = $1d
.endif
.ifndef V2T_BITMAP
V2T_BITMAP = $e000
.endif
.ifndef V2T_SCREEN
V2T_SCREEN = $c000
.endif

; zero page
v2t_ptr = V2T_ZP + 0                    ; 2 bytes each
v2t_src = V2T_ZP + 2
v2t_dst = V2T_ZP + 4
v2t_scr = V2T_ZP + 6
v2t_pp  = V2T_ZP + 8                    ; bitmap byte of the glyph row being drawn
V2T_ZP_SIZE = 10

; draw the .v2t at A/Y at the column, row and leading of its header
v2t_draw:
        sta v2t_ptr
        sty v2t_ptr+1
        ldy #4                          ; x = column * 8
        lda (v2t_ptr),y
        ldx #0
        stx v2t_tx+1
        asl
        asl
        asl
        rol v2t_tx+1
        sta v2t_tx
        iny                             ; y = row * 8
        lda (v2t_ptr),y
        asl
        asl
        asl
        sta v2t_ty
        ldy #9
        lda (v2t_ptr),y
        sta v2t_tlead
        jmp v2t_draw_go

; draw the .v2t at A/Y at pixel v2t_x, v2t_y with leading v2t_lead
v2t_draw_at:
        sta v2t_ptr
        sty v2t_ptr+1
        lda v2t_x
        sta v2t_tx
        lda v2t_x+1
        sta v2t_tx+1
        lda v2t_y
        sta v2t_ty
        lda v2t_lead
        sta v2t_tlead
v2t_draw_go:
        ldy #3                          ; "V2T" + version
:       lda (v2t_ptr),y
        cmp v2t_magic,y
        bne @bad
        dey
        bpl :-
        ldy #8                          ; laid out for this font's height?
        lda (v2t_ptr),y
        cmp #V2T_FONT_H
        bne @bad
        ldy #6
        lda (v2t_ptr),y
        sta v2t_twid
        iny
        lda (v2t_ptr),y
        sta v2t_tleft
        beq @done
        jsr v2t_tpos
        clc                             ; first line
        lda v2t_ptr
        adc #10
        sta v2t_ptr
        bcc @line
        inc v2t_ptr+1
@line:  ldy #0                          ; colour, glyph count
        lda (v2t_ptr),y
        sta v2t_tclr
        iny
        lda (v2t_ptr),y
        sta v2t_tn
        jsr v2t_tnext
        jsr v2t_tnext
        lda v2t_tn
        beq @eol                        ; empty line: nothing to colour or draw
        lda v2t_trow
        cmp #25
        bcs :+
        jsr v2t_tcolrows
:       jsr v2t_tglyphs
@eol:   jsr v2t_tdown
        dec v2t_tleft
        bne @line
@done:  clc
        rts
@bad:   sec
        rts

; one line of text at A/Y (character codes, 0 ends), see the top of the file
v2t_line:
        sta v2t_ptr
        sty v2t_ptr+1
        ldy #0
:       lda (v2t_ptr),y
        beq :+
        iny
        bne :-
:       sty v2t_tn
        lda v2t_x
        sta v2t_tx
        lda v2t_x+1
        sta v2t_tx+1
        lda v2t_y
        sta v2t_ty
        lda v2t_lead
        sta v2t_tlead
        lda v2t_cols
        sta v2t_twid
        lda v2t_color
        sta v2t_tclr
        jsr v2t_tpos
        lda v2t_trow
        cmp #25
        bcs :+
        jsr v2t_tclrrows
        jsr v2t_tcolrows
:       jsr v2t_tglyphs
        php
        lda v2t_y                       ; next line
        clc
        adc #V2T_FONT_H
        bcs @max
        adc v2t_lead
        bcc :+
@max:   lda #$ff
:       sta v2t_y
        plp
        rts

; width of the text at A/Y in pixels -> A (low), X (high)
v2t_measure:
        sta v2t_ptr
        sty v2t_ptr+1
        lda #0
        sta v2t_tend
        sta v2t_tend+1
        tay
@ch:    lda (v2t_ptr),y
        beq @done
        jsr v2t_tglyph
        lda v2t_tw
        clc
        adc v2t_tend
        sta v2t_tend
        bcc :+
        inc v2t_tend+1
:       iny
        bne @ch
@done:  lda v2t_tend
        ldx v2t_tend+1
        rts

; clear v2t_cols x v2t_rows cells from column v2t_col, row v2t_row: bitmap 0, colour A
v2t_clear:
        sta v2t_tclr
        lda v2t_col
        sta v2t_tcol
        lda v2t_cols
        sta v2t_twid
        jsr v2t_tclamp
        lda #0
        sta v2t_cs
        lda #8
        sta v2t_ce
        lda v2t_row
        sta v2t_trow
        lda v2t_rows
        sta v2t_tleft
        beq @done
@row:   lda v2t_trow
        cmp #25
        bcs @done
        tax
        jsr v2t_tzero
        ldx v2t_trow
        jsr v2t_tcolour
        inc v2t_trow
        dec v2t_tleft
        bne @row
@done:  rts

; tx, ty -> tcol, trow, tyo; twid clamped to the screen; xlim = right edge + V2T_FONT_HANG
; (the last glyph's blank columns may hang over it)
v2t_tpos:
        lda v2t_tx+1
        lsr
        lda v2t_tx
        ror
        lsr
        lsr
        sta v2t_tcol
        jsr v2t_tclamp
        lda v2t_ty
        and #7
        sta v2t_tyo
        lda v2t_ty
        lsr
        lsr
        lsr
        sta v2t_trow
        lda v2t_tcol
        clc
        adc v2t_twid
        ldx #0
        stx v2t_xlim+1
        asl
        asl
        asl
        rol v2t_xlim+1
        adc #V2T_FONT_HANG              ; carry is clear (the rol shifted in a 0)
        sta v2t_xlim
        bcc :+
        inc v2t_xlim+1
:       rts

v2t_tclamp:                             ; twid = min(twid, 40 - tcol), 0 if tcol >= 40
        lda #40
        sec
        sbc v2t_tcol
        bcs :+
        lda #0
:       cmp v2t_twid
        bcs :+
        sta v2t_twid
:       rts

v2t_tdown:                              ; next line H + tlead pixel lines down
        lda v2t_tyo
        clc
        adc #V2T_FONT_H
        adc v2t_tlead
@down:  cmp #8
        bcc :+
        sbc #8
        inc v2t_trow
        jmp @down
:       sta v2t_tyo
        rts

v2t_tclrrows:                           ; clear the H pixel lines from trow + tyo (trow < 25)
        lda v2t_tyo
        sta v2t_cs
        clc
        adc #V2T_FONT_H
        sta v2t_tln                     ; lines left, counted from the top of the row
        lda v2t_trow
        sta v2t_trc
@row:   lda v2t_tln
        cmp #8
        bcc :+
        lda #8
:       sta v2t_ce
        ldx v2t_trc
        jsr v2t_tzero
        lda #0
        sta v2t_cs
        lda v2t_tln
        cmp #9
        bcc @done
        sbc #8
        sta v2t_tln
        inc v2t_trc
        lda v2t_trc
        cmp #25
        bcc @row
@done:  rts

v2t_tcolrows:                           ; colour the rows the line touches (trow < 25)
        lda v2t_tyo
        clc
        adc #V2T_FONT_H
        sta v2t_tln
        lda v2t_trow
        sta v2t_trc
@row:   ldx v2t_trc
        jsr v2t_tcolour
        lda v2t_tln
        cmp #9
        bcc @done
        sbc #8
        sta v2t_tln
        inc v2t_trc
        lda v2t_trc
        cmp #25
        bcc @row
@done:  rts

; dst = V2T_BITMAP + X * 320, scr = V2T_SCREEN + X * 40 (bitmap and screen of char row X)
v2t_rowaddr:
        lda #<V2T_BITMAP
        sta v2t_dst
        lda #>V2T_BITMAP
        sta v2t_dst+1
        lda #<V2T_SCREEN
        sta v2t_scr
        lda #>V2T_SCREEN
        sta v2t_scr+1
        cpx #0
        beq @done
@mul:   clc
        lda v2t_dst
        adc #<320
        sta v2t_dst
        lda v2t_dst+1
        adc #>320
        sta v2t_dst+1
        clc
        lda v2t_scr
        adc #40
        sta v2t_scr
        bcc :+
        inc v2t_scr+1
:       dex
        bne @mul
@done:  rts

v2t_tcell:                              ; dst/scr = cell tcol of char row X
        jsr v2t_rowaddr
        lda v2t_tcol
        clc
        adc v2t_scr
        sta v2t_scr
        bcc :+
        inc v2t_scr+1
:       lda v2t_tcol
        asl
        asl
        asl
        bcc :+
        inc v2t_dst+1
:       clc
        adc v2t_dst
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       rts

v2t_tzero:                              ; bitmap bytes cs..ce-1 of twid cells of row X = 0
        jsr v2t_tcell
        ldx v2t_twid
        beq @done
@cell:  lda #0
        ldy v2t_cs
@b:     sta (v2t_dst),y
        iny
        cpy v2t_ce
        bne @b
        lda v2t_dst
        clc
        adc #8
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       dex
        bne @cell
@done:  rts

v2t_tcolour:                            ; twid cells of row X = colour tclr
        jsr v2t_tcell
        lda v2t_tclr
        ldy v2t_twid
        beq @done
@c:     dey
        sta (v2t_scr),y
        bne @c
@done:  rts

; draw tn glyphs from (ptr) at pixel x = tx, row trow + tyo, OR'd into the bitmap; ptr
; ends after them. A glyph that does not end left of xlim and all after it are skipped
; (C=1). Glyph rows below the screen are not drawn.
v2t_tglyphs:
        lda #0
        sta v2t_tclip
        lda v2t_tx
        sta v2t_xlo
        lda v2t_tx+1
        sta v2t_xhi
        lda v2t_trow
        cmp #25
        bcc :+
        lda #$80                        ; off screen: skip all
        sta v2t_tclip
        bne @go
:       tax                             ; dst = bitmap row trow + tyo
        jsr v2t_rowaddr
        lda v2t_tyo
        clc
        adc v2t_dst
        sta v2t_dst
        bcc @go
        inc v2t_dst+1
@go:    lda v2t_tn
        bne @chr
        jmp @end
@chr:   ldy #0
        lda (v2t_ptr),y                 ; character code
        jsr v2t_tnext
        bit v2t_tclip
        bpl :+
        jmp @skip
:       jsr v2t_tglyph
        lda v2t_tw                      ; clip: draw only if x + width <= xlim
        clc
        adc v2t_xlo
        sta v2t_tend
        lda v2t_xhi
        adc #0
        sta v2t_tend+1
        lda v2t_xlim
        cmp v2t_tend
        lda v2t_xlim+1
        sbc v2t_tend+1
        bcs :+
        lda #$80
        sta v2t_tclip
        jmp @skip
:       lda v2t_font_idx+1,x            ; src = font data + offset / 8, tso = offset & 7
        sta v2t_src+1
        lda v2t_font_idx,x
        sta v2t_src
        and #7
        sta v2t_tso
        lsr v2t_src+1
        ror v2t_src
        lsr v2t_src+1
        ror v2t_src
        lsr v2t_src+1
        ror v2t_src
        clc
        lda v2t_src
        adc #<v2t_font_data
        sta v2t_src
        lda v2t_src+1
        adc #>v2t_font_data
        sta v2t_src+1
        lda v2t_xlo                     ; pp = dst + (x & ~7), shift = x & 7
        and #7
        sta v2t_tsh
        lda v2t_xlo
        and #$f8
        clc
        adc v2t_dst
        sta v2t_pp
        lda v2t_xhi
        adc v2t_dst+1
        sta v2t_pp+1
        lda v2t_tyo
        sta v2t_tln
        lda v2t_trow
        sta v2t_trc
        lda #V2T_FONT_H
        sta v2t_trl
@grow:  lda #0                          ; one glyph row, 8 source bits at a time
        sta v2t_tk
        sta v2t_tky
        lda v2t_tw
        sta v2t_trem
@gch:   ldy v2t_tk                      ; 8 bits from bit tso of byte tk, left aligned
        lda (v2t_src),y
        sta v2t_tb0
        iny
        lda (v2t_src),y
        ldx v2t_tso
        beq @al
:       asl
        rol v2t_tb0
        dex
        bne :-
@al:    lda v2t_tb0
        ldx v2t_trem                    ; the glyph's last bits: mask the rest
        cpx #8
        bcs :+
        and v2t_tmask,x
:       cmp #0
        beq @gnext                      ; nothing to draw
        ldx #0
        stx v2t_tlo
        ldx v2t_tsh
        beq @nosh
@sh:    lsr
        ror v2t_tlo
        dex
        bne @sh
@nosh:  ldy v2t_tky
        ora (v2t_pp),y
        sta (v2t_pp),y
        tya
        clc
        adc #8
        tay
        lda v2t_tlo
        ora (v2t_pp),y
        sta (v2t_pp),y
@gnext: lda v2t_trem
        cmp #9
        bcc @gend
        sbc #8                          ; carry is set
        sta v2t_trem
        inc v2t_tk
        lda v2t_tky
        adc #7                          ; carry is set: + 8
        sta v2t_tky
        jmp @gch
@gend:  dec v2t_trl                     ; next glyph row
        beq @adv
        clc
        lda v2t_src
        adc #<V2T_FONT_BPR
        sta v2t_src
        lda v2t_src+1
        adc #>V2T_FONT_BPR
        sta v2t_src+1
        inc v2t_tln
        lda v2t_tln
        cmp #8
        bcs :+
        inc v2t_pp                      ; same char row: next byte
        bne @grow2
        inc v2t_pp+1
@grow2: jmp @grow
:       lda #0                          ; next char row: + 320 - 7
        sta v2t_tln
        inc v2t_trc
        lda v2t_trc
        cmp #25
        bcs @adv                        ; below the screen
        clc
        lda v2t_pp
        adc #<313
        sta v2t_pp
        lda v2t_pp+1
        adc #>313
        sta v2t_pp+1
        jmp @grow
@adv:   clc                             ; x += width
        lda v2t_xlo
        adc v2t_tw
        sta v2t_xlo
        bcc @skip
        inc v2t_xhi
@skip:  dec v2t_tn
        beq @end
        jmp @chr
@end:   lda v2t_tclip
        asl
        rts

v2t_tglyph:                             ; code A -> X = 2 * glyph (index offset), tw = width
        and #$7f                        ; codes 128-255 as 0-127, below 32 as space
        sec
        sbc #32
        bcs :+
        lda #0
:       asl
        tax
        lda v2t_font_idx+2,x
        sec
        sbc v2t_font_idx,x
        sta v2t_tw
        rts

v2t_tnext:
        inc v2t_ptr
        bne :+
        inc v2t_ptr+1
:       rts

; ---- data and state

v2t_magic: .byte "V2T", 4
v2t_tmask: .byte $00, $80, $c0, $e0, $f0, $f8, $fc, $fe

; parameters
v2t_x:     .word 0                      ; text pixel position
v2t_y:     .byte 0
v2t_lead:  .byte 2                      ; pixel lines between text lines
v2t_color: .byte $f0                    ; light grey on black
v2t_col:   .byte 0                      ; v2t_clear: cells
v2t_row:   .byte 0
v2t_cols:  .byte 40                     ; v2t_line, v2t_clear: width in cells
v2t_rows:  .byte 1

; internal
v2t_tx:    .word 0
v2t_ty:    .byte 0
v2t_tlead: .byte 0
v2t_tcol:  .byte 0
v2t_trow:  .byte 0
v2t_tyo:   .byte 0                      ; pixel line of the text line within char row trow
v2t_twid:  .byte 0
v2t_tleft: .byte 0
v2t_tn:    .byte 0
v2t_tw:    .byte 0
v2t_tclr:  .byte 0
v2t_tclip: .byte 0
v2t_tlo:   .byte 0
v2t_tsh:   .byte 0                      ; x & 7
v2t_tso:   .byte 0                      ; glyph's bit offset & 7
v2t_tb0:   .byte 0
v2t_tk:    .byte 0                      ; source byte of the glyph row
v2t_tky:   .byte 0                      ; 8 * tk: its bitmap byte
v2t_trem:  .byte 0                      ; bits of the glyph row left
v2t_trl:   .byte 0                      ; glyph rows left
v2t_tln:   .byte 0                      ; pixel line within char row trc
v2t_trc:   .byte 0
v2t_xlo:   .byte 0
v2t_xhi:   .byte 0
v2t_xlim:  .word 0
v2t_tend:  .word 0
v2t_cs:    .byte 0
v2t_ce:    .byte 0

        .include "font.inc"
