; v2t: proportional text on a C64 hires bitmap: .v2t text files (docs/v2t-format.md) and
; single lines. ca65 source: .include it in the host program, with font.inc (generated by
; vic2/build.py: glyphs in byte columns, format in docs/v2t-format.md) on the include path.
; API in docs/v2t-lib.md; in short (A/Y = address: A low, Y high; text is character codes
; 32-127, ASCII; H = the font's height, V2T_FONT_H):
;
;   v2t_draw       A/Y = .v2t: draw it at the position in its header. C=1: not a .v2t
;                  (or made for a font of another height)
;   v2t_draw_at    A/Y = .v2t: draw it at pixel v2t_x, v2t_y, leading v2t_lead
;   v2t_line       A/Y = 0-terminated text: clear the H pixel lines at v2t_x, v2t_y over
;                  v2t_cols cells (not if v2t_over is non-zero), colour them v2t_color,
;                  draw the text clipped to them; then v2t_y += H + v2t_lead. C=1: clipped
;   v2t_measure    A/Y = 0-terminated text: width in pixels in A (low), X (high)
;   v2t_clear      A = colour: clear v2t_cols x v2t_rows cells from v2t_col, v2t_row
;   v2t_paint      A = colour: colour the same cells, leaving the bitmap as it is
;
; The bitmap (8000 bytes) and screen (the cell colours) are at v2t_bitmap and v2t_screen,
; $e000 and $c000 by default (where v2i.inc puts them; define V2T_BITMAP and V2T_SCREEN
; before the include for other defaults, or change the variables at run time). Everything
; is drawn only in char rows v2t_rtop to v2t_rbot - 1 (default 0-24; rows up to 31 can be
; addressed, so a bitmap address 1-7 rows early lets lines start above row 0). Glyphs are OR'd in, so the bitmap must read back as RAM (bank out a ROM above
; it). The program sets up the VIC (hires bitmap mode, bank, $d018). Colours are cell
; colours, fg << 4 | bg. Zero page: V2T_ZP_SIZE bytes from V2T_ZP (default $1d).

.ifndef V2T_ZP
V2T_ZP = $1d
.endif
.ifndef V2T_BITMAP
V2T_BITMAP = $e000
.endif
.ifndef V2T_SCREEN
V2T_SCREEN = $c000
.endif

; zero page
v2t_ptr = V2T_ZP + 0                    ; 2 bytes each
v2t_src = V2T_ZP + 2
v2t_dst = V2T_ZP + 4
v2t_scr = V2T_ZP + 6
v2t_pp  = V2T_ZP + 8                    ; bitmap bytes of the glyph column being drawn
v2t_pp2 = V2T_ZP + 10
v2t_tlo = V2T_ZP + 12                   ; 1 byte: the shifted glyph byte's right part
V2T_ZP_SIZE = 13

; draw the .v2t at A/Y at the column, row and leading of its header
v2t_draw:
        sta v2t_ptr
        sty v2t_ptr+1
        ldy #4                          ; x = column * 8
        lda (v2t_ptr),y
        ldx #0
        stx v2t_tx+1
        asl
        asl
        asl
        rol v2t_tx+1
        sta v2t_tx
        iny                             ; y = row * 8
        lda (v2t_ptr),y
        asl
        asl
        asl
        sta v2t_ty
        ldy #9
        lda (v2t_ptr),y
        sta v2t_tlead
        jmp v2t_draw_go

; draw the .v2t at A/Y at pixel v2t_x, v2t_y with leading v2t_lead
v2t_draw_at:
        sta v2t_ptr
        sty v2t_ptr+1
        lda v2t_x
        sta v2t_tx
        lda v2t_x+1
        sta v2t_tx+1
        lda v2t_y
        sta v2t_ty
        lda v2t_lead
        sta v2t_tlead
v2t_draw_go:
        ldy #3                          ; "V2T" + version
:       lda (v2t_ptr),y
        cmp v2t_magic,y
        bne @bad
        dey
        bpl :-
        ldy #8                          ; laid out for this font's height?
        lda (v2t_ptr),y
        cmp #V2T_FONT_H
        bne @bad
        ldy #6
        lda (v2t_ptr),y
        sta v2t_twid
        iny
        lda (v2t_ptr),y
        sta v2t_tleft
        beq @done
        jsr v2t_tpos
        clc                             ; first line
        lda v2t_ptr
        adc #10
        sta v2t_ptr
        bcc @line
        inc v2t_ptr+1
@line:  ldy #0                          ; colour, glyph count
        lda (v2t_ptr),y
        sta v2t_tclr
        iny
        lda (v2t_ptr),y
        sta v2t_tn
        jsr v2t_tnext
        jsr v2t_tnext
        lda v2t_tn
        beq @eol                        ; empty line: nothing to colour or draw
        jsr v2t_tcolrows
        jsr v2t_tglyphs
@eol:   jsr v2t_tdown
        dec v2t_tleft
        bne @line
@done:  clc
        rts
@bad:   sec
        rts

; one line of text at A/Y (character codes, 0 ends), see the top of the file
v2t_line:
        sta v2t_ptr
        sty v2t_ptr+1
        ldy #0
:       lda (v2t_ptr),y
        beq :+
        iny
        bne :-
:       sty v2t_tn
        lda v2t_x
        sta v2t_tx
        lda v2t_x+1
        sta v2t_tx+1
        lda v2t_y
        sta v2t_ty
        lda v2t_lead
        sta v2t_tlead
        lda v2t_cols
        sta v2t_twid
        lda v2t_color
        sta v2t_tclr
        jsr v2t_tpos
        lda v2t_over
        bne :+
        jsr v2t_tclrrows
:       jsr v2t_tcolrows
        jsr v2t_tglyphs
        php
        lda v2t_y                       ; next line
        clc
        adc #V2T_FONT_H
        bcs @max
        adc v2t_lead
        bcc :+
@max:   lda #$ff
:       sta v2t_y
        plp
        rts

; width of the text at A/Y in pixels -> A (low), X (high)
v2t_measure:
        sta v2t_ptr
        sty v2t_ptr+1
        lda #0
        sta v2t_tend
        sta v2t_tend+1
        tay
@ch:    lda (v2t_ptr),y
        beq @done
        jsr v2t_tglyph
        lda v2t_tw
        clc
        adc v2t_tend
        sta v2t_tend
        bcc :+
        inc v2t_tend+1
:       iny
        bne @ch
@done:  lda v2t_tend
        ldx v2t_tend+1
        rts

; clear v2t_cols x v2t_rows cells from column v2t_col, row v2t_row: bitmap 0, colour A
v2t_clear:
        sta v2t_tclr
        lda #8
        bne v2t_tarea

; colour v2t_cols x v2t_rows cells from column v2t_col, row v2t_row: colour A, bitmap untouched
v2t_paint:
        sta v2t_tclr
        lda #0                          ; ce = 0: no bitmap bytes
v2t_tarea:
        sta v2t_ce
        lda v2t_col
        sta v2t_tcol
        lda v2t_cols
        sta v2t_twid
        jsr v2t_tclamp
        lda #0
        sta v2t_cs
        lda v2t_row
        sta v2t_trow
        lda v2t_rows
        sta v2t_tleft
        beq @done
@row:   lda v2t_trow
        cmp v2t_rbot
        bcs @done
        cmp v2t_rtop
        bcc @next
        tax
        lda v2t_ce
        beq :+
        jsr v2t_tzero
:       ldx v2t_trow
        jsr v2t_tcolour
@next:  inc v2t_trow
        dec v2t_tleft
        bne @row
@done:  rts

; tx, ty -> tcol, trow, tyo; twid clamped to the screen; xlim = right edge + V2T_FONT_HANG
; (the last glyph's blank columns may hang over it)
v2t_tpos:
        lda v2t_tx+1
        lsr
        lda v2t_tx
        ror
        lsr
        lsr
        sta v2t_tcol
        jsr v2t_tclamp
        lda v2t_ty
        and #7
        sta v2t_tyo
        lda v2t_ty
        lsr
        lsr
        lsr
        sta v2t_trow
        lda v2t_tcol
        clc
        adc v2t_twid
        ldx #0
        stx v2t_xlim+1
        asl
        asl
        asl
        rol v2t_xlim+1
        adc #V2T_FONT_HANG              ; carry is clear (the rol shifted in a 0)
        sta v2t_xlim
        bcc :+
        inc v2t_xlim+1
:       rts

v2t_tclamp:                             ; twid = min(twid, 40 - tcol), 0 if tcol >= 40
        lda #40
        sec
        sbc v2t_tcol
        bcs :+
        lda #0
:       cmp v2t_twid
        bcs :+
        sta v2t_twid
:       rts

v2t_tdown:                              ; next line H + tlead pixel lines down
        lda v2t_tyo
        clc
        adc #V2T_FONT_H
        adc v2t_tlead
@down:  cmp #8
        bcc :+
        sbc #8
        inc v2t_trow
        jmp @down
:       sta v2t_tyo
        rts

v2t_tclrrows:                           ; clear the H pixel lines from trow + tyo
        lda v2t_tyo
        sta v2t_cs
        clc
        adc #V2T_FONT_H
        sta v2t_tln                     ; lines left, counted from the top of the row
        lda v2t_trow
        sta v2t_trc
@row:   lda v2t_trc
        cmp v2t_rbot
        bcs @done
        lda v2t_tln
        cmp #8
        bcc :+
        lda #8
:       sta v2t_ce
        ldx v2t_trc
        cpx v2t_rtop
        bcc :+
        jsr v2t_tzero
:       lda #0
        sta v2t_cs
        lda v2t_tln
        cmp #9
        bcc @done
        sbc #8
        sta v2t_tln
        inc v2t_trc
        bne @row
@done:  rts

v2t_tcolrows:                           ; colour the rows the line touches
        lda v2t_tyo
        clc
        adc #V2T_FONT_H
        sta v2t_tln
        lda v2t_trow
        sta v2t_trc
@row:   ldx v2t_trc
        cpx v2t_rbot
        bcs @done
        cpx v2t_rtop
        bcc :+
        jsr v2t_tcolour
:       lda v2t_tln
        cmp #9
        bcc @done
        sbc #8
        sta v2t_tln
        inc v2t_trc
        bne @row
@done:  rts

; dst = v2t_bitmap + X * 320, scr = v2t_screen + X * 40 (bitmap and screen of char row X)
v2t_rowaddr:
        clc
        lda v2t_bitmap
        adc v2t_r320lo,x
        sta v2t_dst
        lda v2t_bitmap+1
        adc v2t_r320hi,x
        sta v2t_dst+1
        clc
        lda v2t_screen
        adc v2t_r40lo,x
        sta v2t_scr
        lda v2t_screen+1
        adc v2t_r40hi,x
        sta v2t_scr+1
        rts

v2t_tcell:                              ; dst/scr = cell tcol of char row X
        jsr v2t_rowaddr
        lda v2t_tcol
        clc
        adc v2t_scr
        sta v2t_scr
        bcc :+
        inc v2t_scr+1
:       lda v2t_tcol
        asl
        asl
        asl
        bcc :+
        inc v2t_dst+1
:       clc
        adc v2t_dst
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       rts

v2t_tzero:                              ; bitmap bytes cs..ce-1 of twid cells of row X = 0
        jsr v2t_tcell
        ldx v2t_twid
        beq @done
        lda v2t_cs
        bne @cell
        lda v2t_ce
        cmp #8
        bne @cell
@full:  lda #0                          ; whole cells, unrolled
        ldy #7
        .repeat 7
        sta (v2t_dst),y
        dey
        .endrep
        sta (v2t_dst),y
        lda v2t_dst
        clc
        adc #8
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       dex
        bne @full
        rts
@cell:  lda #0
        ldy v2t_cs
@b:     sta (v2t_dst),y
        iny
        cpy v2t_ce
        bne @b
        lda v2t_dst
        clc
        adc #8
        sta v2t_dst
        bcc :+
        inc v2t_dst+1
:       dex
        bne @cell
@done:  rts

v2t_tcolour:                            ; twid cells of row X = colour tclr
        jsr v2t_tcell
        lda v2t_tclr
        ldy v2t_twid
        beq @done
@c:     dey
        sta (v2t_scr),y
        bne @c
@done:  rts

; draw tn glyphs from (ptr) at pixel x = tx, row trow + tyo, OR'd into the bitmap; ptr
; ends after them. A glyph that does not end left of xlim and all after it are skipped
; (C=1). Glyph rows outside char rows rtop..rbot-1 are not drawn. A glyph is drawn one byte column
; (8 pixels wide, font.inc) at a time, top to bottom: Y is the pixel line in the char row,
; for the bitmap and (src = column - first line) the font. Each byte is shifted right by
; x & 7 into two bitmap bytes, pp and pp2 = pp + 8, through the entry for that shift
; (patched into @sj): 1-4 right, 5-7 as 3-1 left.
v2t_tglyphs:
        lda #0
        sta v2t_tclip
        lda v2t_tx
        sta v2t_xlo
        lda v2t_tx+1
        sta v2t_xhi
        sec                             ; xrem = xlim - x
        lda v2t_xlim
        sbc v2t_tx
        sta v2t_xrem
        lda v2t_xlim+1
        sbc v2t_tx+1
        sta v2t_xrem+1
        lda v2t_trow                    ; first char row in the clip window: tr0, from
        sta v2t_tr0                     ; line ty0 of it, glyph rows left trl0, the
        cmp v2t_rtop                    ; column's byte for line 0 of it at + tsoff
        bcs @vis
        lda v2t_rtop                    ; above the window: skip 8 * (rtop - trow) - tyo
        sta v2t_tr0                     ; glyph rows
        sec
        sbc v2t_trow
        asl
        asl
        asl
        sec
        sbc v2t_tyo
        sta v2t_tsoff
        lda #V2T_FONT_H
        sec
        sbc v2t_tsoff
        bcc @off                        ; the line ends above it
        beq @off
        sta v2t_trl0
        lda #0
        sta v2t_ty0
        sta v2t_tsoff+1
        beq @row
@vis:   lda #V2T_FONT_H
        sta v2t_trl0
        lda v2t_tyo
        sta v2t_ty0
        lda #0
        sec
        sbc v2t_tyo
        sta v2t_tsoff
        lda #0
        sbc #0
        sta v2t_tsoff+1
@row:   lda v2t_tr0
        cmp v2t_rbot
        bcs @off
        tax                             ; dst = bitmap row tr0
        jsr v2t_rowaddr
        jmp @go
@off:   lda #$80                        ; outside the clip window: skip all
        sta v2t_tclip
@go:    lda v2t_tn
        bne @chr
        jmp @end
@chr:   ldy #0
        lda (v2t_ptr),y                 ; character code
        inc v2t_ptr
        bne :+
        inc v2t_ptr+1
:       bit v2t_tclip
        bpl :+
        jmp @skip
:       and #$7f                        ; X = glyph, tw = width (as v2t_tglyph)
        sec
        sbc #32
        bcs :+
        lda #0
:       tax
        lda v2t_font_w,x
        sta v2t_tw
        ldy v2t_xrem+1                  ; clip: draw only if width <= xlim - x
        bmi @clip
        bne :+
        cmp v2t_xrem
        beq :+
        bcc :+
@clip:  lda #$80
        sta v2t_tclip
        jmp @skip
:       lda v2t_font_nb,x               ; byte columns with ink
        bne :+
        jmp @adv
:       sta v2t_tk
        lda v2t_font_lo,x
        sta v2t_tg
        lda v2t_font_hi,x
        sta v2t_tg+1
        lda v2t_xlo                     ; shift entry for x & 7
        and #7
        tay
        lda @sjlo,y
        sta @sj+1
        lda @sjhi,y
        sta @sj+2
        lda v2t_xlo                     ; tp = dst + (x & ~7)
        and #$f8
        clc
        adc v2t_dst
        sta v2t_tp
        lda v2t_xhi
        adc v2t_dst+1
        sta v2t_tp+1
@col:   clc                             ; src = column + tsoff, pp = tp, pp2 = tp + 8
        lda v2t_tg
        adc v2t_tsoff
        sta v2t_src
        lda v2t_tg+1
        adc v2t_tsoff+1
        sta v2t_src+1
        lda v2t_tp
        sta v2t_pp
        clc
        adc #8
        sta v2t_pp2
        lda v2t_tp+1
        sta v2t_pp+1
        adc #0
        sta v2t_pp2+1
        lda v2t_trl0
        sta v2t_trl
        lda v2t_tr0
        sta v2t_trc
        ldy v2t_ty0
@seg:   tya                             ; lines y..tye-1 of this char row
        clc
        adc v2t_trl
        cmp #9
        bcs :+
        sta v2t_tye                     ; the column ends in it
        lda #0
        sta v2t_trl
        beq @draw
:       sbc #8                          ; carry is set
        sta v2t_trl
        lda #8
        sta v2t_tye
@draw:  ldx #0
@byte:  lda (v2t_src),y
        beq @nb
        stx v2t_tlo
@sj:    jmp @shi                        ; patched
@sr4:   lsr
        ror v2t_tlo
@sr3:   lsr
        ror v2t_tlo
@sr2:   lsr
        ror v2t_tlo
@sr1:   lsr
        ror v2t_tlo
@shi:   ora (v2t_pp),y                  ; A = left part, tlo = right part
        sta (v2t_pp),y
        lda v2t_tlo
        beq @nb
        ora (v2t_pp2),y
        sta (v2t_pp2),y
@nb:    iny
        cpy v2t_tye
        bne @byte
        lda v2t_trl
        beq @ncol
        inc v2t_trc                     ; next char row: src + 8, pp/pp2 + 320
        lda v2t_trc
        cmp v2t_rbot
        bcs @ncol                       ; below the clip window
        clc
        lda v2t_src
        adc #8
        sta v2t_src
        bcc :+
        inc v2t_src+1
:       clc
        lda v2t_pp
        adc #<320
        sta v2t_pp
        lda v2t_pp+1
        adc #>320
        sta v2t_pp+1
        clc
        lda v2t_pp2
        adc #<320
        sta v2t_pp2
        lda v2t_pp2+1
        adc #>320
        sta v2t_pp2+1
        ldy #0
        jmp @seg
@ncol:  dec v2t_tk                      ; next byte column: tg + H, tp + 8
        beq @adv
        clc
        lda v2t_tg
        adc #V2T_FONT_H
        sta v2t_tg
        bcc :+
        inc v2t_tg+1
:       clc
        lda v2t_tp
        adc #8
        sta v2t_tp
        bcc :+
        inc v2t_tp+1
:       jmp @col
@sl3:   asl                             ; 8 - shift left: A = right part, tlo = left
        rol v2t_tlo
@sl2:   asl
        rol v2t_tlo
@sl1:   asl
        rol v2t_tlo
        ora (v2t_pp2),y
        sta (v2t_pp2),y
        lda v2t_tlo
        ora (v2t_pp),y
        sta (v2t_pp),y
        jmp @nb
@adv:   clc                             ; x += width, xrem -= width
        lda v2t_xlo
        adc v2t_tw
        sta v2t_xlo
        bcc :+
        inc v2t_xhi
:       sec
        lda v2t_xrem
        sbc v2t_tw
        sta v2t_xrem
        bcs @skip
        dec v2t_xrem+1
@skip:  dec v2t_tn
        beq @end
        jmp @chr
@end:   lda v2t_tclip
        asl
        rts
@sjlo:  .byte <@shi, <@sr1, <@sr2, <@sr3, <@sr4, <@sl3, <@sl2, <@sl1
@sjhi:  .byte >@shi, >@sr1, >@sr2, >@sr3, >@sr4, >@sl3, >@sl2, >@sl1

v2t_tglyph:                             ; code A -> X = glyph index, tw = width
        and #$7f                        ; codes 128-255 as 0-127, below 32 as space
        sec
        sbc #32
        bcs :+
        lda #0
:       tax
        lda v2t_font_w,x
        sta v2t_tw
        rts

v2t_tnext:
        inc v2t_ptr
        bne :+
        inc v2t_ptr+1
:       rts

; ---- data and state

v2t_magic: .byte "V2T", 4
v2t_r320lo: .repeat 32, I               ; char row offsets in bitmap and screen
        .byte <(I * 320)
        .endrep
v2t_r320hi: .repeat 32, I
        .byte >(I * 320)
        .endrep
v2t_r40lo: .repeat 32, I
        .byte <(I * 40)
        .endrep
v2t_r40hi: .repeat 32, I
        .byte >(I * 40)
        .endrep

; parameters
v2t_x:     .word 0                      ; text pixel position
v2t_y:     .byte 0
v2t_lead:  .byte 2                      ; pixel lines between text lines
v2t_color: .byte $f0                    ; light grey on black
v2t_col:   .byte 0                      ; v2t_clear: cells
v2t_row:   .byte 0
v2t_cols:  .byte 40                     ; v2t_line, v2t_clear: width in cells
v2t_rows:  .byte 1
v2t_over:  .byte 0                      ; v2t_line: 0 clears its pixel lines first, else ORs
v2t_bitmap: .word V2T_BITMAP            ; bitmap and screen drawn into
v2t_screen: .word V2T_SCREEN
v2t_rtop:  .byte 0                      ; clip window: char rows rtop..rbot-1 (rbot <= 32)
v2t_rbot:  .byte 25

; internal
v2t_tx:    .word 0
v2t_ty:    .byte 0
v2t_tlead: .byte 0
v2t_tcol:  .byte 0
v2t_trow:  .byte 0
v2t_tyo:   .byte 0                      ; pixel line of the text line within char row trow
v2t_twid:  .byte 0
v2t_tleft: .byte 0
v2t_tn:    .byte 0
v2t_tw:    .byte 0
v2t_tclr:  .byte 0
v2t_tclip: .byte 0
v2t_tk:    .byte 0                      ; byte columns of the glyph left
